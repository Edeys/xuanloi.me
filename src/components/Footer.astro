---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div class="py-6 text-center space-y-4">
    <div class="flex flex-col items-center gap-2">
      <span class="text-sm text-foreground/60 font-medium">Kết nối với tôi</span>
      <Socials centered />
    </div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <a href="https://github.com/Edeys/xuanloi.me" target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        CC BY 4.0 · Code MIT
      </a>
    </div>
  </div>
</footer>

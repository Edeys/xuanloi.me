---
export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Xuân Lợi",
      url: "https://xuanloi.me/about",
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Xuân Lợi",
      logo: {
        "@type": "ImageObject",
        url: "https://xuanloi.me/og.png",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://xuanloi.me/og.png",
    articleSection: data.tags?.[0] || "",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Xuân Lợi",
    url: "https://xuanloi.me",
    image: "https://xuanloi.me/og.png",
    sameAs: [
      "https://github.com/Edeys",
      "https://www.youtube.com/@xuanloi_mkt",
      "https://www.facebook.com/xuanloi.me",
    ],
    jobTitle: "Blogger",
    description:
      "Chia sẻ về cuộc sống, marketing và những điều tôi học được trên hành trình của mình.",
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Xuân Lợi",
    url: "https://xuanloi.me",
    description:
      "Chia sẻ về cuộc sống, marketing và những điều tôi học được trên hành trình của mình.",
    author: {
      "@type": "Person",
      name: "Xuân Lợi",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://xuanloi.me/search?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
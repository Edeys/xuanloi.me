---
export interface Props {
  type: "BlogPosting" | "BreadcrumbList" | "Person" | "WebSite" | "FAQPage";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${data.url || "https://xuanloi.me"}#blogposting`,
    headline: data.title,
    description: data.description,
    author: { "@id": "https://xuanloi.me/#person" },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: { "@id": "https://xuanloi.me/#person" },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://xuanloi.me/og.png",
    articleSection: data.tags?.[0] || "",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
    inLanguage: "vi",
  };
} else if (type === "BreadcrumbList") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Trang chủ",
        item: "https://xuanloi.me/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Bài viết",
        item: "https://xuanloi.me/posts/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: data.title,
        item: data.url,
      },
    ],
  };
} else if (type === "FAQPage") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: (data.questions || []).map((q: { question: string; answer: string }) => ({
      "@type": "Question",
      name: q.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: q.answer,
      },
    })),
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://xuanloi.me/#person",
    name: "Đào Xuân Lợi",
    url: "https://xuanloi.me",
    image: "https://xuanloi.me/assets/avatar_round.webp",
    sameAs: [
      "https://github.com/Edeys",
      "https://www.youtube.com/@xuanloi_mkt",
      "https://www.facebook.com/xuanloi.me",
    ],
    jobTitle: "Content Creator & Marketer",
    description: "Chia sẻ về cuộc sống, marketing và những điều tôi học được trên hành trình của mình.",
    knowsAbout: [
      "Phát triển bản thân",
      "Marketing",
      "Tâm lý học",
      "Xây dựng thương hiệu cá nhân",
      "Nông nghiệp",
      "Trí tuệ nhân tạo",
    ],
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://xuanloi.me/#website",
    name: "Đào Xuân Lợi",
    url: "https://xuanloi.me",
    description: "Chia sẻ về cuộc sống, marketing và những điều tôi học được trên hành trình của mình.",
    inLanguage: "vi",
    author: { "@id": "https://xuanloi.me/#person" },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://xuanloi.me/search?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
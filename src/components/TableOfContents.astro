<nav id="table-of-contents" class="toc not-prose" aria-label="Mục lục">
  <details open>
    <summary class="toc-toggle">
      <span class="toc-title">Mục lục</span>
      <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </summary>
    <ul class="toc-list" id="toc-list"></ul>
  </details>
</nav>

<style>
  .toc {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  @media (min-width: 1024px) {
    .toc {
      float: right;
      width: 14rem;
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
      z-index: 10;
    }
  }

  .toc-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    background: var(--color-bg, #f8f9fa);
    border: 1px solid var(--color-border, #e5e7eb);
    user-select: none;
    list-style: none;
  }

  .toc-toggle::-webkit-details-marker {
    display: none;
  }

  .toc-title {
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground, #374151);
  }

  .toc-chevron {
    transition: transform 0.2s;
    color: var(--color-foreground, #9ca3af);
  }

  details[open] .toc-chevron {
    transform: rotate(90deg);
  }

  .toc-list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    color: var(--color-foreground, #4b5563);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border-left: 2px solid transparent;
    line-height: 1.4;
  }

  .toc-link:hover {
    background: var(--color-bg-hover, #f3f4f6);
    color: var(--color-accent, #10b981);
  }

  .toc-link.active {
    color: var(--color-accent, #10b981);
    border-left-color: var(--color-accent, #10b981);
    background: var(--color-bg-active, rgba(16, 185, 129, 0.08));
    font-weight: 500;
  }

  .toc-link-h3 {
    padding-left: 1.5rem;
    font-size: 0.8125rem;
  }

  /* Dark mode overrides via data-theme */
  [data-theme="dark"] .toc-toggle {
    background: var(--color-bg, #1f2937);
    border-color: var(--color-border, #374151);
  }

  [data-theme="dark"] .toc-title {
    color: var(--color-foreground, #e5e7eb);
  }

  [data-theme="dark"] .toc-chevron {
    color: var(--color-foreground, #6b7280);
  }

  [data-theme="dark"] .toc-link {
    color: var(--color-foreground, #9ca3af);
  }

  [data-theme="dark"] .toc-link:hover {
    background: var(--color-bg-hover, #374151);
  }

  [data-theme="dark"] .toc-link.active {
    background: var(--color-bg-active, rgba(16, 185, 129, 0.12));
  }
</style>

<script>
  function buildToC() {
    const article = document.querySelector("#article");
    const tocList = document.getElementById("toc-list");
    if (!article || !tocList) return;

    // Clear any existing items (for astro:page-load re-runs)
    tocList.innerHTML = "";

    // Get all headings
    const headings = article.querySelectorAll("h2, h3");
    if (headings.length === 0) {
      // Hide the whole ToC if no headings
      const toc = document.getElementById("table-of-contents");
      if (toc) toc.style.display = "none";
      return;
    }

    const items: { tag: string; id: string; text: string }[] = [];

    headings.forEach((h) => {
      const id = h.id;
      if (!id) return;
      const text = h.textContent?.trim() || "";
      if (!text) return;
      items.push({ tag: h.tagName.toLowerCase(), id, text });
    });

    if (items.length === 0) return;

    // Render tree: h2 top-level, h3 nested under previous h2
    let currentUl = tocList;
    let lastH2Li: HTMLLIElement | null = null;

    items.forEach((item) => {
      const li = document.createElement("li");
      li.className = "toc-item";

      const a = document.createElement("a");
      a.className = "toc-link";
      if (item.tag === "h3") {
        a.classList.add("toc-link-h3");
      }
      a.href = "#" + item.id;
      a.textContent = item.text;
      a.dataset.targetId = item.id;

      a.addEventListener("click", (e) => {
        e.preventDefault();
        const target = document.getElementById(item.id);
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          // Update URL hash without jump
          history.pushState(null, "", "#" + item.id);
        }
      });

      li.appendChild(a);

      if (item.tag === "h2") {
        currentUl.appendChild(li);
        lastH2Li = li;
      } else if (item.tag === "h3" && lastH2Li) {
        // Create or reuse sub-ul under last h2
        let subUl = lastH2Li.querySelector("ul");
        if (!subUl) {
          subUl = document.createElement("ul");
          subUl.className = "toc-list";
          // Reset gap for nested
          subUl.style.marginTop = "0";
          lastH2Li.appendChild(subUl);
        }
        subUl.appendChild(li);
      } else {
        // h3 without preceding h2 — treat as top-level
        currentUl.appendChild(li);
      }
    });

    // Scroll spy: IntersectionObserver
    const headingElements = items
      .map((item) => document.getElementById(item.id))
      .filter(Boolean) as HTMLElement[];

    if (headingElements.length === 0) return;

    const allLinks = tocList.querySelectorAll<HTMLAnchorElement>(".toc-link");

    const observer = new IntersectionObserver(
      (entries) => {
        let activeId = "";

        // Collect visible headings priority
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Use the first visible heading from top
            const id = entry.target.id;
            if (!activeId || entry.boundingClientRect.top < document.getElementById(activeId)!.getBoundingClientRect().top) {
              activeId = id;
            }
          }
        });

        if (!activeId) {
          // If nothing visible, find the last heading that's above viewport
          let lastAbove = "";
          headingElements.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < 100) {
              lastAbove = el.id;
            }
          });
          activeId = lastAbove;
        }

        // Update active class
        allLinks.forEach((link) => {
          link.classList.remove("active");
          if (link.dataset.targetId === activeId) {
            link.classList.add("active");
          }
        });
      },
      {
        rootMargin: "-80px 0px -70% 0px",
        threshold: 0,
      }
    );

    headingElements.forEach((el) => observer.observe(el));
  }

  // Run on load and on Astro page transitions
  document.addEventListener("DOMContentLoaded", buildToC);
  document.addEventListener("astro:page-load", buildToC);
</script>

---
export interface TocItem {
  id: string;
  text: string;
  tag: "h2" | "h3";
}

export interface Props {
  items?: TocItem[];
}

const { items = [] } = Astro.props;

// Nest h3 under the most recent h2
const nested: { id: string; text: string; children: { id: string; text: string }[] }[] = [];
for (const item of items) {
  if (item.tag === "h2") {
    nested.push({ id: item.id, text: item.text, children: [] });
  } else if (item.tag === "h3" && nested.length > 0) {
    nested[nested.length - 1].children.push({ id: item.id, text: item.text });
  } else if (item.tag === "h3") {
    nested.push({ id: item.id, text: item.text, children: [] });
  }
}
---

<nav id="table-of-contents" class="toc not-prose" aria-label="Mục lục">
  <details open class="toc-details">
    <summary class="toc-toggle">
      <span class="toc-title">Mục lục</span>
      <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </summary>
    {
      nested.length > 0 ? (
        <ul class="toc-list" id="toc-list">
          {nested.map((item) => (
            <li class="toc-item">
              <a class="toc-link" href={`#${item.id}`} data-target-id={item.id}>{item.text}.</a>
              {
                item.children.length > 0 && (
                  <ul class="toc-list" style="margin-top:0">
                    {item.children.map((child) => (
                      <li class="toc-item">
                        <a class="toc-link toc-link-h3" href={`#${child.id}`} data-target-id={child.id}>{child.text}.</a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </li>
          ))}
        </ul>
      ) : (
        <ul class="toc-list" id="toc-list"></ul>
      )
    }
  </details>
</nav>

<style>
  .toc {
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  .toc-details {
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
    background: var(--background);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .toc-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    user-select: none;
    list-style: none;
  }

  .toc-toggle::-webkit-details-marker {
    display: none;
  }

  .toc-title {
    font-weight: 600;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--foreground);
  }

  .toc-chevron {
    transition: transform 0.2s;
    color: var(--foreground);
    opacity: 0.5;
  }

  details[open] .toc-chevron {
    transform: rotate(90deg);
  }

  .toc-list {
    margin: 0;
    padding: 0 0.75rem 0.75rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-item {
    margin: 0;
  }

  :global(.toc-link) {
    display: block;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--accent);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border: 1px solid transparent;
    line-height: 1.5;
    opacity: 0.85;
  }

  :global(.toc-link:hover) {
    background: var(--muted);
    color: var(--accent);
    opacity: 1;
  }

  :global(.toc-link.active) {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-weight: 500;
    opacity: 1;
  }

  :global(.toc-link-h3) {
    padding-left: 1.5rem;
    font-size: 0.9375rem;
  }
</style>

<script>
  // Scroll-spy only: items are pre-rendered server-side (no CLS).
  function setupScrollSpy(article, tocList) {
    const items = Array.from(tocList.querySelectorAll("a.toc-link"))
      .map((a) => ({
        el: a,
        target: document.getElementById(a.dataset.targetId || ""),
      }))
      .filter((x) => x.target);

    if (items.length === 0) return;

    const allLinks = tocList.querySelectorAll<HTMLAnchorElement>(".toc-link");

    const observer = new IntersectionObserver(
      (entries) => {
        let activeId = "";
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            if (
              !activeId ||
              entry.boundingClientRect.top <
                document.getElementById(activeId)!.getBoundingClientRect().top
            ) {
              activeId = id;
            }
          }
        });

        if (!activeId) {
          let lastAbove = "";
          items.forEach(({ target }) => {
            if (target.getBoundingClientRect().top < 100) lastAbove = target.id;
          });
          activeId = lastAbove;
        }

        allLinks.forEach((link) => {
          link.classList.remove("active");
          if (link.dataset.targetId === activeId) link.classList.add("active");
        });
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
    );

    items.forEach(({ target }) => observer.observe(target));

    // Smooth-scroll on click (prevent default jump)
    allLinks.forEach((a) => {
      a.addEventListener("click", (e) => {
        const id = a.dataset.targetId;
        const target = id && document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.pushState(null, "", "#" + id);
      });
    });
  }

  function init() {
    const article = document.querySelector("#article");
    const tocList = document.getElementById("toc-list");
    if (article && tocList) setupScrollSpy(article, tocList);
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>
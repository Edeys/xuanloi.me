---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`Cảm ơn bạn! | ${SITE.title}`}
  description="Đăng ký nhận bài viết qua email thành công trên blog của Đào Xuân Lợi."
  noindex
>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-3xl flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <div
        class="flex size-16 items-center justify-center rounded-full bg-accent/10 text-3xl font-bold text-accent"
        aria-hidden="true"
      >
        &#10003;
      </div>
      <h1 class="mt-6 text-2xl font-bold sm:text-3xl">Cảm ơn bạn đã đăng ký!</h1>
      <p class="mt-3 max-w-md text-center text-foreground/70">
        Từ giờ, bài viết mới và những câu chuyện thực tế sẽ gửi thẳng vào email của bạn.
        2 lần mỗi tháng — nội dung chất lượng, không spam.
      </p>
      <div class="my-6 flex flex-wrap items-center justify-center gap-6">
        <LinkButton
          href="/posts/"
          class="text-lg underline decoration-dashed underline-offset-8"
        >
          Đọc bài viết
        </LinkButton>
        <LinkButton
          href="/"
          class="text-lg underline decoration-dashed underline-offset-8"
        >
          Về trang chủ
        </LinkButton>
      </div>
    </div>
  </main>
  <Footer />
</Layout>


# =============================================
# xuanloi.me - LiteSpeed/.htaccess hardening
# =============================================

# --- Custom error pages ---
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# --- Disable directory listing (hardening) ---
Options -Indexes

# --- Canonical host: redirect www -> non-www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.xuanloi\.me$ [NC]
  RewriteRule ^(.*)$ https://xuanloi.me/$1 [L,R=301]

  # --- 301 redirects: old post URLs -> year-based URLs (2026-08-06 restructure) ---
  RewriteRule ^posts/bai-hoc-phat-trien-ban-than/?$ /posts/2020/bai-hoc-phat-trien-ban-than/ [L,R=301]
  RewriteRule ^posts/bat-dau-voi-marketing-so/?$ /posts/2020/bat-dau-voi-marketing-so/ [L,R=301]
  RewriteRule ^posts/tai-sao-muon-tien-len-mai-khong-lam-duoc/?$ /posts/2020/tai-sao-muon-tien-len-mai-khong-lam-duoc/ [L,R=301]
  RewriteRule ^posts/2026/vi-sao-nguoi-gioi-lai-kho-len-tieng-nhat/?$ /posts/2021/vi-sao-nguoi-gioi-lai-kho-len-tieng-nhat/ [L,R=301]
  RewriteRule ^posts/2026/not-to-do-list-xay-thuong-hieu-ca-nhan/?$ /posts/2021/not-to-do-list-xay-thuong-hieu-ca-nhan/ [L,R=301]
  RewriteRule ^posts/2026/cang-lon-cang-kho-yeu/?$ /posts/2022/cang-lon-cang-kho-yeu/ [L,R=301]
  RewriteRule ^posts/2026/so-chon-sai-nghe/?$ /posts/2022/so-chon-sai-nghe/ [L,R=301]
  RewriteRule ^posts/2026/self-help-trap/?$ /posts/2022/self-help-trap/ [L,R=301]
  RewriteRule ^posts/bai-tap-dinh-hinh-noi-so/?$ /posts/2023/bai-tap-dinh-hinh-noi-so/ [L,R=301]
  RewriteRule ^posts/2026/17-cau-hoi-thay-doi-cuoc-doi/?$ /posts/2023/17-cau-hoi-thay-doi-cuoc-doi/ [L,R=301]
  RewriteRule ^posts/khoanh-khac-nhan-ra-suc-khoe-bi-hong/?$ /posts/2024/khoanh-khac-nhan-ra-suc-khoe-bi-hong/ [L,R=301]
  RewriteRule ^posts/2026/ty-phu-xe-om-chan-ly-ve-dat-nong-nghiep/?$ /posts/2024/ty-phu-xe-om-chan-ly-ve-dat-nong-nghiep/ [L,R=301]
  RewriteRule ^posts/2026/23-ban-nhap-8-thang-0-bai-dang/?$ /posts/2025/23-ban-nhap-8-thang-0-bai-dang/ [L,R=301]
  RewriteRule ^posts/2026/dau-tu-nong-nghiep-cai-bay-cua-nhung-nguoi-nghi-minh-thong-minh/?$ /posts/2025/dau-tu-nong-nghiep-cai-bay-cua-nhung-nguoi-nghi-minh-thong-minh/ [L,R=301]
  RewriteRule ^posts/2026/tuoi-tre-khong-tien-khong-nguoi-hau-thuan/?$ /posts/2025/tuoi-tre-khong-tien-khong-nguoi-hau-thuan/ [L,R=301]

  # --- Newsletter API: internal rewrite to PHP relay (keeps POST method) ---
  RewriteRule ^api/subscribe/?$ api/subscribe.php [L]

  # --- Block web access to private project folder (serve 404 to hide existence) ---
  RewriteRule ^dautudatnongnghiep(/|$) - [R=404,L]
</IfModule>

# --- Security headers (origin level) ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  Header set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# --- MIME types ---
AddType application/manifest+json .webmanifest
AddType application/xml .xml
AddType image/svg+xml .svg

# --- Compression (static assets) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain application/xml image/svg+xml application/manifest+json
</IfModule>

# --- Cache static assets (hashed filenames are immutable) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# --- OG images: short cache (regenerated every build) ---
<FilesMatch "index\.png$">
  Header set Cache-Control "public, max-age=3600"
</FilesMatch>
